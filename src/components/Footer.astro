---
import FooterLink from "./FooterLink.astro";
import SocialLinks from "./SocialLinks.astro";
import { headerLinks } from "@/lib/headerlinks";

const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} embeddedt. All rights reserved.
    <div class="footer-links">
        {headerLinks.map(h => <FooterLink href={h.url}>{h.name}</FooterLink>)}
    </div>
	<div class="social-container">
		<SocialLinks/>
	</div>
</footer>
<style>
	footer {
		padding: 2em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
	.social-container {
		margin-top: 1em;
	}

    .footer-links {
        padding: 1em 0;
    }

    @media (min-width: 401px) {
        .footer-links {
            display: none;
        }
    }
</style>
